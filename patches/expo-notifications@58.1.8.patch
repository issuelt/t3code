@@ -82,12 +82,24 @@ internal final class NotificationDelegateRegistry {
     state.withLock { $0.delegates.removeAll { $0 === delegate } }
   }
 
-  func appendPendingResponse(_ response: UNNotificationResponse) {
-    state.withLock { $0.pendingResponses.append(response) }
+  /**
+   Queues the response before it is delivered, and returns the delegates to deliver it to. A
+   delegate that registers during delivery then finds the response in `add`.
+   */
+  func appendPendingResponse(_ response: UNNotificationResponse) -> [NotificationDelegate] {
+    state.withLock { state in
+      state.pendingResponses.append(response)
+      return state.delegates
+    }
   }
 
-  func removeAllPendingResponses() {
-    state.withLock { $0.pendingResponses.removeAll() }
+  /**
+   Removes only the given responses, so that responses received during delegate callbacks stay
+   queued.
+   */
+  func removePendingResponses(_ responses: [UNNotificationResponse]) {
+    let identifiers = Set(responses.map(ObjectIdentifier.init))
+    state.withLock { $0.pendingResponses.removeAll { identifiers.contains(ObjectIdentifier($0)) } }
   }
 }
 
